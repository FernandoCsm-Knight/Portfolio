{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/projetos",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/sobre",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/precos",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/contato",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/projects",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/((?!images/|docs/|assets/|robots.txt|sitemap.xml|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
