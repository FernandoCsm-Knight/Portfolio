{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error",
    "no-unused-vars": "warn"
  },
  "overrides": [
    {
      "files": [
        "api/**/*.js",
        "scripts/**/*.mjs"
      ],
      "env": {
        "node": true,
        "es2024": true
      }
    }
  ]
}
