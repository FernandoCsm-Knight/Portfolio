# ============================================================
# CLIENTE — só o que tem prefixo VITE_ é copiado para dentro do
# bundle pelo Vite, e portanto é público.
#
# O prefixo NÃO é cosmético: é a fronteira que mantém os segredos
# fora do navegador. Renomear SUPABASE_SECRET_KEY para VITE_…
# publicaria a chave para qualquer visitante. Nunca ponha segredo
# aqui: dá para ler tudo no DevTools.
# ============================================================

VITE_SUPABASE_URL=
# Chave Publishable (`sb_publishable_…`). Pública por design.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Chave de SITE do reCAPTCHA Enterprise. Também pública por design — ela vai
# no <script> de qualquer página que use reCAPTCHA.
#
# As funções em /api leem esta mesma variável: a Vercel injeta todas as
# variáveis no runtime da função, com prefixo ou sem. O prefixo decide só o
# outro sentido — o que entra no bundle.
VITE_RECAPTCHA_SITE_KEY=

VITE_WHATSAPP_URL=
VITE_GITHUB_URL=
VITE_MAIL_URL=
VITE_LINKEDIN_URL=

# ============================================================
# SERVIDOR — sem o prefixo VITE_, logo fora do bundle.
# Usadas apenas pelas funções em /api. Estas SÃO segredo.
# ============================================================

# Supabase → Settings → API Keys → Secret key (`sb_secret_…`), a geração que
# substituiu o JWT `service_role`. Ignora a RLS: é o que permite a /api gravar
# depois de verificar o token, com o insert do papel anon já revogado.
SUPABASE_SECRET_KEY=

# ID do projeto no Google Cloud — NÃO é a site key.
# Aparece no seletor de projetos do console, no formato "meu-projeto-123456".
RECAPTCHA_PROJECT_ID=

# Google Cloud → APIs e serviços → Credenciais → Chave de API. SEGREDO.
RECAPTCHA_API_KEY=

# Opcional: nota mínima para aceitar um envio (padrão 0.5, faixa 0.0–1.0).
RECAPTCHA_MIN_SCORE=

# Opcional, só para depurar: com 1, uma recusa devolve o motivo no corpo da
# resposta (nota baixa, domínio errado, ação divergente). Vazio em produção.
RECAPTCHA_DEBUG=
